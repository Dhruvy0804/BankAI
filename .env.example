# Local-only synthetic data. Copy to .env; never commit real secrets.
APP_ENV=development
APP_SECRET_KEY=replace-with-a-long-random-local-secret
DATABASE_URL=postgresql+psycopg://bankai:bankai_dev_only@127.0.0.1:55432/bankai
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=1024
CHAT_MODE=agents
AGENT_BASE_URL=http://127.0.0.1:8000
AGENT_TIMEOUT_SECONDS=150
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# Phase 7: set provider=gemini and model=gemini-embedding-001.
# Blank EMBEDDING_API_KEY reuses LLM_API_KEY. Ingest explicitly; no startup billing.
LIVEKIT_URL=
LIVEKIT_INTERNAL_URL=
# Local Docker: internal ws://livekit:7880; browser ws://localhost:7880.
# Set NODE_IP to the host LAN IPv4 for Docker WebRTC media; no effect on cloud URLs.
LIVEKIT_NODE_IP=127.0.0.1
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
VOICE_ENABLED=false
STT_PROVIDER=
STT_API_KEY=
STT_MODEL=gemini-3.5-transcribe
TTS_PROVIDER=
TTS_API_KEY=
TTS_MODEL=gemini-3.8-flash-lite-tts
ACCESS_TOKEN_EXPIRE_MINUTES=30
CONFIRMATION_EXPIRE_SECONDS=300

# Outbound phone demo. Keep credentials and approved numbers in ignored .env.
PHONE_ENABLED=false
PHONE_PROVIDER=plivo
PHONE_OWNER_CUSTOMER_ID=
EVALUATION_OWNER_CUSTOMER_ID=
EVALUATION_LIVE_ENABLED=false
EVALUATION_CELL_COOLDOWN_SECONDS=65
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PHONE_PUBLIC_BASE_URL=
PHONE_CALLER_NUMBER=
PHONE_ALLOWED_NUMBERS=
PHONE_MAX_DURATION_SECONDS=300
