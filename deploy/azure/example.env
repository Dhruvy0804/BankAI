# Copy this file to deploy/azure/.env on the Azure VM. Never commit the populated file.
# Use a unique Azure public-IP DNS label, for example bankai-demo.centralindia.cloudapp.azure.com.
PUBLIC_HOST=replace-with-azure-fqdn
AZURE_PUBLIC_IP=replace-with-vm-public-ip

# Use the same long, URL-safe password in both values.
POSTGRES_PASSWORD=replace-with-random-alphanumeric-password
DATABASE_URL=postgresql+psycopg://bankai:replace-with-random-alphanumeric-password@db:5432/bankai
APP_SECRET_KEY=replace-with-random-32-byte-or-longer-secret
CHAT_MODE=agents

LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001

LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
VOICE_ENABLED=false
STT_PROVIDER=gemini
TTS_PROVIDER=gemini

PHONE_ENABLED=false
PHONE_PROVIDER=plivo
PHONE_OWNER_CUSTOMER_ID=
EVALUATION_OWNER_CUSTOMER_ID=
EVALUATION_LIVE_ENABLED=false
PHONE_CALLER_NUMBER=
PHONE_ALLOWED_NUMBERS=
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PHONE_MAX_DURATION_SECONDS=120
